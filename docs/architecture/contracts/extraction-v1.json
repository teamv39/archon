{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archon.dev/schemas/extraction/1.0.json",
  "title": "Archon Extraction Contract",
  "description": "Канонический контракт передачи фактов архитектуры из контура извлечения (extract, interpret) в модуль model и модуль export. Спецификация: docs/architecture/contracts/README.md",
  "type": "object",
  "required": ["$schema_version", "repository", "product"],
  "properties": {
    "$schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "const": "1.0"
    },
    "repository": { "$ref": "#/$defs/Repository" },
    "product": { "$ref": "#/$defs/Product" },
    "containers": {
      "type": "array",
      "items": { "$ref": "#/$defs/Container" }
    },
    "external_systems": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExternalSystem" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/Relationship" }
    },
    "flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/Flow" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "$ref": "#/$defs/Uncertainty" }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "EvidenceFile": {
      "type": "string",
      "minLength": 1
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "EntityRef": {
      "type": "string",
      "pattern": "^(product|container|external):[a-z0-9][a-z0-9-]*$"
    },
    "DotPath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+|\\[\\d+\\])*$"
    },

    "Repository": {
      "type": "object",
      "required": ["url", "commit_sha", "default_branch", "scanned_at"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "default_branch": { "type": "string" },
        "primary_language": { "type": "string" },
        "scanned_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "Product": {
      "type": "object",
      "required": ["slug", "name", "team_slug", "team_name", "evidence_files"],
      "properties": {
        "slug": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "team_slug": { "$ref": "#/$defs/Slug" },
        "team_name": { "type": "string", "minLength": 1 },
        "business_description": { "type": ["string", "null"] },
        "tech_description": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "Container": {
      "type": "object",
      "required": ["slug", "name", "kind", "evidence_files"],
      "properties": {
        "slug": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["service", "database", "cache", "queue", "storage", "job", "other"]
        },
        "technology": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "ExternalSystem": {
      "type": "object",
      "required": ["slug", "name", "scope", "evidence_files"],
      "properties": {
        "slug": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["internal", "external"] },
        "description": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "Relationship": {
      "type": "object",
      "required": ["source", "target", "label", "kind", "evidence_files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "source": { "$ref": "#/$defs/EntityRef" },
        "target": { "$ref": "#/$defs/EntityRef" },
        "label": { "type": "string", "minLength": 1 },
        "technology": { "type": ["string", "null"] },
        "kind": {
          "enum": ["api_call", "data", "event", "sync", "async", "other"]
        },
        "direction": {
          "enum": ["outbound", "inbound"],
          "default": "outbound"
        },
        "inferred_from": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "Flow": {
      "type": "object",
      "required": ["slug", "name", "steps", "evidence_files"],
      "properties": {
        "slug": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/FlowStep" },
          "minItems": 1
        },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "FlowStep": {
      "type": "object",
      "required": ["order", "from", "to", "action"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "from": { "$ref": "#/$defs/EntityRef" },
        "to": { "$ref": "#/$defs/EntityRef" },
        "action": { "type": "string", "minLength": 1 },
        "parallel_group": { "type": ["integer", "null"], "minimum": 1 },
        "evidence_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceFile" }
        }
      },
      "additionalProperties": false
    },

    "Uncertainty": {
      "type": "object",
      "required": ["field", "reason", "confidence"],
      "properties": {
        "field": { "$ref": "#/$defs/DotPath" },
        "reason": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/Confidence" }
      },
      "additionalProperties": false
    }
  }
}
