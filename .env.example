# ==============================================================================
# Archon Local Development Environment (.env)
# ==============================================================================

# PostgreSQL 16 + Apache AGE
POSTGRES_HOST=localhost
POSTGRES_PORT=5455
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=archon

# Redis 7 (MCP Cache & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector DB (Semantic Search & Drift)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
